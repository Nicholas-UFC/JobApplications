# Backend
SECRET_KEY=Chave_Secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:4000,http://localhost:8000

# Conta ADMIN criada no boot do container backend
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Trocar123

# Banco PostgreSQL (serviço db no Docker; sem POSTGRES_HOST usa SQLite local)
POSTGRES_DB=jobapplications
POSTGRES_USER=jobapplications
POSTGRES_PASSWORD=Trocar123
POSTGRES_PORT=5432
# Porta externa do Postgres no host (5432 ocupado? use 5433)
POSTGRES_EXPOSTA=5433

# Frontend local (compose sobrescreve para http://backend:8000 no SSR)
BACKEND_URL=http://localhost:8000
PORT=4000
# Hosts permitidos pelo SSR do Angular (proteção SSRF)
NG_ALLOWED_HOSTS=localhost,127.0.0.1,frontend
